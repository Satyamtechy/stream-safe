{
  "name": "stream-safe",
  "version": "1.1.0",
  "type": "module",
  "description": "Streaming HTML sanitizer for LLM output — zero dependencies",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sanitize",
    "html",
    "xss",
    "streaming",
    "llm",
    "ai",
    "security",
    "sanitizer",
    "stream",
    "dompurify-alternative"
  ],
  "author": "Satyamtechy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Satyamtechy/stream-safe.git"
  },
  "homepage": "https://github.com/Satyamtechy/stream-safe#readme",
  "bugs": {
    "url": "https://github.com/Satyamtechy/stream-safe/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.29.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "3.1.4",
    "tsup": "8.5.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
